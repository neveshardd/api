# Copie para `.dev.vars` (nunca versionar o arquivo real).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3001
# Vazio em desenvolvimento: o link do convite é exibido no terminal do `next dev`.
RESEND_API_KEY=
# Token de API do R2 (S3): R2 > Manage API tokens > Object Read & Write no bucket agage-backoffice-media.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Chaves de TESTE públicas da Cloudflare (sempre aprovam). Em produção use as do seu widget.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
